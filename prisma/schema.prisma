generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CoupleStatus {
  ACTIVE
  ELIMINATED
}

enum EpisodeStatus {
  PAST
  LIVE
  UPCOMING
}

enum PredictionKind {
  SEASON_WINNER
  WEEKLY_ELIMINATION
  WEEKLY_SCORE
  WEEKLY_RANK
}

enum PrizeContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  displayName   String?
  avatarUrl     String?
  image         String?
  totalPoints   Int       @default(0)
  role          Role      @default(USER)
  rootingForCoupleId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rootingForCouple   Couple?  @relation("UserRootingFor", fields: [rootingForCoupleId], references: [id], onDelete: SetNull)
  accounts    Account[]
  sessions    Session[]
  predictions Prediction[]
  predictionEvents PredictionEvent[]
  prizeContributions PrizeContribution[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Couple {
  id                  String       @id @default(cuid())
  celebrityName       String
  proName             String
  imageUrl            String?
  /** Optional headshot for the pro partner. */
  proImageUrl         String?
  status              CoupleStatus @default(ACTIVE)
  eliminatedEpisodeId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  eliminatedEpisode          Episode?       @relation("CoupleEliminatedEpisode", fields: [eliminatedEpisodeId], references: [id])
  actualResults              ActualResult[]
  scorePredictions           Prediction[]   @relation("PredictionCouple")
  seasonWinnerPredictions    Prediction[]   @relation("SeasonWinnerCouple")
  eliminatedPredictions      Prediction[]   @relation("PredictedEliminatedCouple")
  rootingFans                User[]         @relation("UserRootingFor")
}

model Episode {
  id            String        @id @default(cuid())
  episodeNumber Int           @unique
  title         String
  airDate       DateTime
  status        EpisodeStatus @default(UPCOMING)
  isFinale      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  eliminatedCouples Couple[]       @relation("CoupleEliminatedEpisode")
  actualResults     ActualResult[]
  predictions       Prediction[]
  predictionEvents  PredictionEvent[]
}

model ActualResult {
  id           String  @id @default(cuid())
  episodeId    String
  coupleId     String
  judgeScore   Float?
  isEliminated Boolean @default(false)

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  couple  Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  @@unique([episodeId, coupleId])
}

model Prediction {
  id                          String         @id @default(cuid())
  userId                      String
  kind                        PredictionKind
  seasonWinnerCoupleId        String?
  /** Episode number when the current season-winner couple was first locked in. Resets only when the couple changes. */
  seasonWinnerFromEpisodeNumber Int?
  episodeId                   String?
  coupleId                    String?
  predictedScore              Float?
  predictedRank               Int?
  predictedEliminatedCoupleId String?

  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonWinnerCouple        Couple?  @relation("SeasonWinnerCouple", fields: [seasonWinnerCoupleId], references: [id])
  episode                   Episode? @relation(fields: [episodeId], references: [id])
  couple                    Couple?  @relation("PredictionCouple", fields: [coupleId], references: [id])
  predictedEliminatedCouple Couple?  @relation("PredictedEliminatedCouple", fields: [predictedEliminatedCoupleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
  @@index([userId, episodeId, kind])
  @@index([userId, episodeId, coupleId, kind])
}

/**
 * Append-only audit log of every prediction save.
 * Never UPDATE or DELETE these rows — use for historical timelines.
 */
model PredictionEvent {
  id        String   @id @default(cuid())
  userId    String
  episodeId String?
  /** Snapshot of the save payload (season / elim / ranks). */
  payload   Json
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, episodeId, createdAt])
}

/** Singleton app-wide settings (id is always "default"). */
model AppSettings {
  id             String   @id @default("default")
  /** Prize pool total in CAD cents (kept in sync with PrizeContribution sum). */
  prizePoolCents Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt
}

/** Who put money into the prize pool (player or outside guest). */
model PrizeContribution {
  id          String                   @id @default(cuid())
  /** Amount in CAD cents. */
  amountCents Int
  /** Linked pool player, if any. */
  userId      String?
  /** Free-form name when the contributor is not a pool user. */
  guestName   String?
  note        String?
  status      PrizeContributionStatus  @default(APPROVED)
  createdAt   DateTime                 @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}
